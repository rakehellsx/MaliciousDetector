   </layout>
  </item>
  <item>
   <widget class="QTabWidget" name="m_tabReport">
    <widget class="QWidget" name="tabOverview">
     <attribute name="title"><string>概览</string></attribute>
     <layout class="QVBoxLayout">
      <item>
       <layout class="QFormLayout">
        <item row="0" column="0"><widget class="QLabel"><property name="text"><string>报告编号：</string></property></widget></item>
        <item row="0" column="1"><widget class="QLabel" name="m_lblReportId"><property name="text"><string>—</string></property></widget></item>
        <item row="1" column="0"><widget class="QLabel"><property name="text"><string>生成时间：</string></property></widget></item>
        <item row="1" column="1"><widget class="QLabel" name="m_lblReportTime"><property name="text"><string>—</string></property></widget></item>
        <item row="2" column="0"><widget class="QLabel"><property name="text"><string>主机名：</string></property></widget></item>
        <item row="2" column="1"><widget class="QLabel" name="m_lblHostname"><property name="text"><string>—</string></property></widget></item>
        <item row="3" column="0"><widget class="QLabel"><property name="text"><string>操作系统：</string></property></widget></item>
        <item row="3" column="1"><widget class="QLabel" name="m_lblOs"><property name="text"><string>—</string></property></widget></item>
        <item row="4" column="0"><widget class="QLabel"><property name="text"><string>IP地址：</string></property></widget></item>
        <item row="4" column="1"><widget class="QLabel" name="m_lblIp"><property name="text"><string>—</string></property></widget></item>
       </layout>
      </item>
      <item>
       <layout class="QHBoxLayout" name="cardRow">
        <item><widget class="QFrame" name="cardHigh"><layout class="QVBoxLayout"><item><widget class="QLabel" name="m_cardHighCount"><property name="text"><string>0</string></property></widget></item></layout></widget></item>
        <item><widget class="QFrame" name="cardMed"><layout class="QVBoxLayout"><item><widget class="QLabel" name="m_cardMediumCount"><property name="text"><string>0</string></property></widget></item></layout></widget></item>
        <item><widget class="QFrame" name="cardLow"><layout class="QVBoxLayout"><item><widget class="QLabel" name="m_cardLowCount"><property name="text"><string>0</string></property></widget></item></layout></widget></item>
        <item><widget class="QFrame" name="cardClean"><layout class="QVBoxLayout"><item><widget class="QLabel" name="m_cardCleanCount"><property name="text"><string>0</string></property></widget></item></layout></widget></item>
       </layout>
      </item>
      <item>
       <widget class="QTableWidget" name="m_tblModuleStat">
        <property name="alternatingRowColors"><bool>true</bool></property>
        <property name="editTriggers"><set>QAbstractItemView::NoEditTriggers</set></property>
        <column><property name="text"><string>检测模块</string></property></column>
        <column><property name="text"><string>高危</string></property></column>
        <column><property name="text"><string>中危</string></property></column>
        <column><property name="text"><string>低危</string></property></column>
        <column><property name="text"><string>安全</string></property></column>
       </widget>
      </item>
     </layout>
    </widget>
    <widget class="QWidget" name="tabThreats">
     <attribute name="title"><string>威胁详情</string></attribute>
     <layout class="QVBoxLayout">
      <item>
       <layout class="QHBoxLayout">
        <item><widget class="QLineEdit" name="m_edtThreatKw"><property name="placeholderText"><string>威胁名 / 文件名</string></property></widget></item>
        <item>
         <widget class="QComboBox" name="m_cmbThreatRisk">
          <item><property name="text"><string>全部风险</string></property></item>
          <item><property name="text"><string>高危</string></property></item>
          <item><property name="text"><string>中危</string></property></item>
          <item><property name="text"><string>低危</string></property></item>
         </widget>
        </item>
        <item>
         <widget class="QComboBox" name="m_cmbThreatCat">
          <item><property name="text"><string>全部类别</string></property></item>
          <item><property name="text"><string>静态检测</string></property></item>
          <item><property name="text"><string>动态行为</string></property></item>
          <item><property name="text"><string>文件关联</string></property></item>
         </widget>
        </item>
        <item><widget class="QPushButton" name="btnQueryThreats"><property name="text"><string>查询</string></property></widget></item>
        <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
        <item><widget class="QLabel" name="m_lblThreatCount"><property name="text"><string></string></property></widget></item>
       </layout>
      </item>
      <item>
       <widget class="QTableWidget" name="m_tblThreats">
        <property name="alternatingRowColors"><bool>true</bool></property>
        <property name="editTriggers"><set>QAbstractItemView::NoEditTriggers</set></property>
        <property name="selectionBehavior"><enum>QAbstractItemView::SelectRows</enum></property>
