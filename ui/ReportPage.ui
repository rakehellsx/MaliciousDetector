    </widget>
    <widget class="QWidget" name="tabSchedule">
     <attribute name="title"><string>定时生成</string></attribute>
     <layout class="QVBoxLayout">
      <item>
       <widget class="QGroupBox" name="grpSchedule">
        <property name="title"><string>定时策略配置</string></property>
        <layout class="QFormLayout">
         <item row="0" column="0"><widget class="QLabel"><property name="text"><string>生成模式：</string></property></widget></item>
         <item row="0" column="1">
          <widget class="QComboBox" name="m_cmbScheduleMode">
           <item><property name="text"><string>每天</string></property></item>
           <item><property name="text"><string>每周一</string></property></item>
           <item><property name="text"><string>每周五</string></property></item>
           <item><property name="text"><string>每小时</string></property></item>
          </widget>
         </item>
         <item row="1" column="0"><widget class="QLabel"><property name="text"><string>生成时刻：</string></property></widget></item>
         <item row="1" column="1">
          <layout class="QHBoxLayout">
           <item><widget class="QSpinBox" name="m_spinHour"><property name="maximum"><number>23</number></property></widget></item>
           <item><widget class="QLabel"><property name="text"><string>时</string></property></widget></item>
           <item><widget class="QSpinBox" name="m_spinMinute"><property name="maximum"><number>59</number></property></widget></item>
           <item><widget class="QLabel"><property name="text"><string>分</string></property></widget></item>
          </layout>
         </item>
         <item row="2" column="0"><widget class="QLabel"><property name="text"><string>下次触发：</string></property></widget></item>
         <item row="2" column="1"><widget class="QLabel" name="m_lblNextFire"><property name="text"><string>—</string></property></widget></item>
        </layout>
       </widget>
      </item>
      <item>
       <layout class="QHBoxLayout">
        <item><widget class="QPushButton" name="btnSaveSchedule"><property name="text"><string>保存策略</string></property></widget></item>
        <item><widget class="QPushButton" name="btnToggleTimer"><property name="text"><string>启动定时</string></property></widget></item>
        <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
        <item><widget class="QLabel" name="m_lblTimerStatus"><property name="text"><string>● 未启动</string></property></widget></item>
       </layout>
      </item>
     </layout>
