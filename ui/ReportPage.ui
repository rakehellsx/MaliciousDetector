        <column><property name="text"><string>详情</string></property></column>
        <column><property name="text"><string>检测时间</string></property></column>
       </widget>
      </item>
     </layout>
    </widget>
    <widget class="QWidget" name="tabHostInfo">
     <attribute name="title"><string>主机信息</string></attribute>
     <layout class="QVBoxLayout">
      <item><widget class="QTextEdit" name="m_txtHostInfo"><property name="readOnly"><bool>true</bool></property></widget></item>
