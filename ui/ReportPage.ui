 <layout class="QVBoxLayout" name="mainLayout">
  <item>
   <layout class="QHBoxLayout" name="topRow">
    <item><widget class="QLabel" name="lblPageTitle"><property name="text"><string>检测报告</string></property></widget></item>
    <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
    <item><widget class="QPushButton" name="btnGenerate"><property name="text"><string>生成报告</string></property></widget></item>
